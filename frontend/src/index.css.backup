:root {
  --bg: #0d110e;
  --bg-soft: #171d18;
  --panel: #141a15;
  --panel-alt: #19201a;
  --border: rgba(225, 236, 220, 0.12);
  --border-strong: rgba(225, 236, 220, 0.22);
  --text: #eff3e9;
  --muted: #a3ada0;
  --primary: #c8ee70;
  --primary-strong: #a8cf4d;
  --danger: #ff9079;
  --fraud-chart: #ff5b45;
  --danger-soft: rgba(255, 144, 121, 0.14);
  --safe: #83d9a9;
  --safe-soft: rgba(131, 217, 169, 0.14);
  --sky: #83c8d4;
  --chart-grid: rgba(225, 236, 220, 0.1);
  --shadow: rgba(0, 0, 0, 0.32);
}

* {
  box-sizing: border-box;
}

::selection {
  background: rgba(200, 238, 112, 0.28);
  color: var(--text);
}

html, body, #root {
  min-height: 100%;
  height: 100%;
}

body {
  margin: 0;
  font-family: "Space Grotesk Variable", "Segoe UI", sans-serif;
  background-color: var(--bg);
  background-image:
    linear-gradient(rgba(225, 236, 220, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(225, 236, 220, 0.025) 1px, transparent 1px);
  background-size: 48px 48px;
  color: var(--text);
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  padding: 38px 28px 56px;
}

.dashboard {
  width: min(1360px, 100%);
  margin: 0 auto;
  animation: dashboard-enter 480ms ease-out both;
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin-bottom: 24px;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--border);
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(200, 238, 112, 0.42);
  border-radius: 8px;
  background: rgba(200, 238, 112, 0.1);
  color: var(--primary);
  font-family: "IBM Plex Mono", monospace;
  font-size: 0.9rem;
  font-weight: 500;
}

.eyebrow {
  margin: 0 0 5px;
  font-size: 0.76rem;
  text-transform: uppercase;
  color: var(--primary);
}

h1 {
  margin: 0;
  font-size: 2rem;
  font-weight: 600;
  line-height: 1.15;
}

.brand-copy {
  min-width: 0;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  border: 1px solid var(--border);
  white-space: nowrap;
}

.status-indicator {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 10px currentColor;
}

.status-pill.neutral {
  background: rgba(148, 163, 184, 0.12);
  color: var(--muted);
}

.status-pill.low {
  background: var(--safe-soft);
  color: var(--safe);
}

.status-pill.high {
  background: var(--danger-soft);
  color: var(--danger);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 22px;
  animation: section-enter 500ms 60ms ease-out both;
}

.overview-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 18px;
  margin: 0 0 13px;
}

.overview-heading .eyebrow {
  margin-bottom: 3px;
}

.overview-heading h2 {
  margin: 0;
  font-size: 1.24rem;
  font-weight: 600;
}

.overview-meta {
  display: flex;
  align-items: center;
  gap: 16px;
  color: var(--muted);
  font-size: 0.78rem;
}

.overview-model {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  text-transform: uppercase;
  white-space: nowrap;
}

.overview-model .status-indicator {
  width: 6px;
  height: 6px;
  flex-basis: 6px;
}

.overview-model.active {
  color: var(--safe);
}

.overview-model.active .status-indicator {
  box-shadow: 0 0 11px rgba(131, 217, 169, 0.7);
}

.chart-grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 22px;
  animation: section-enter 500ms 100ms ease-out both;
}

.performance-panel {
  margin-bottom: 20px;
  animation: section-enter 500ms 90ms ease-out both;
}

.performance-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 16px;
}

.performance-heading h2 {
  margin: 0;
  font-size: 1.08rem;
}

.performance-heading p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 0.82rem;
  text-transform: capitalize;
}

.model-status {
  padding: 5px 9px;
  border: 1px solid var(--border);
  border-radius: 999px;
  color: var(--muted);
  font-size: 0.72rem;
  text-transform: uppercase;
}

.model-status.active {
  border-color: rgba(131, 217, 169, 0.35);
  background: var(--safe-soft);
  color: var(--safe);
}

.performance-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-top: 1px solid var(--border);
}

.performance-metric {
  display: grid;
  gap: 6px;
  padding: 14px 12px 2px 0;
}

.performance-metric + .performance-metric {
  padding-left: 16px;
  border-left: 1px solid var(--border);
}

.performance-metric span {
  color: var(--muted);
  font-size: 0.8rem;
}

.performance-metric strong {
  font-family: "IBM Plex Mono", monospace;
  font-size: 1.25rem;
  font-weight: 500;
}

.stat-card {
  --stat-accent: var(--primary);
  position: relative;
  min-height: 126px;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(200, 238, 112, 0.07), var(--panel-alt) 62%);
  border: 1px solid var(--border);
  border-top: 2px solid var(--stat-accent);
  border-radius: 8px;
  padding: 17px 19px 15px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

.stat-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
}

.stat-fraud {
  --stat-accent: var(--danger);
  background: linear-gradient(135deg, rgba(255, 144, 121, 0.07), var(--panel-alt) 62%);
}

.stat-volume {
  --stat-accent: var(--sky);
  background: linear-gradient(135deg, rgba(131, 200, 212, 0.07), var(--panel-alt) 62%);
}

.stat-prediction {
  --stat-accent: var(--safe);
  background: linear-gradient(135deg, rgba(131, 217, 169, 0.06), var(--panel-alt) 62%);
}

.stat-prediction:has(+ .stat-fraud) {
  --stat-accent: var(--safe);
}

.stat-card span {
  color: var(--muted);
  font-size: 0.84rem;
  font-weight: 500;
}

.stat-card strong {
  color: var(--text);
  font-family: "IBM Plex Mono", monospace;
  font-size: 1.7rem;
  font-weight: 500;
  line-height: 1.25;
}

.stat-card small {
  color: var(--muted);
  font-size: 0.76rem;
}

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(270px, 0.75fr);
  gap: 16px;
  animation: section-enter 500ms 140ms ease-out both;
}

.panel {
  background: linear-gradient(145deg, rgba(225, 236, 220, 0.025), var(--panel) 42%);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 22px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.panel-header h2,
.result-panel h2 {
  margin: 0;
  font-size: 1.16rem;
  font-weight: 600;
}

.quick-actions {
  display: flex;
  gap: 10px;
}

.ghost {
  border: 1px solid var(--border);
  background: rgba(225, 236, 220, 0.035);
  color: var(--text);
  border-radius: 6px;
  padding: 8px 11px;
  font-size: 0.83rem;
  font-weight: 500;
  transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
}

.ghost:hover {
  border-color: var(--border-strong);
  background: rgba(225, 236, 220, 0.08);
  transform: translateY(-1px);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 15px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: var(--muted);
  font-size: 0.86rem;
  font-weight: 500;
}

input, select {
  width: 100%;
  min-height: 44px;
  border: 1px solid var(--border);
  background: #101510;
  color: var(--text);
  border-radius: 6px;
  padding: 10px 12px;
  transition: border-color 140ms ease, box-shadow 140ms ease;
}

input:focus, select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(200, 238, 112, 0.12);
}

input[name="transaction_id"],
input[name="merchant_id"],
input[name="customer_id"] {
  font-family: "IBM Plex Mono", monospace;
  font-size: 0.86rem;
}

.checkbox-row {
  flex-direction: row !important;
  align-items: center;
  gap: 10px !important;
  margin-top: 8px;
  min-height: 44px;
}

.checkbox-row input {
  width: 18px;
  height: 18px;
  accent-color: var(--primary-strong);
}

.primary-btn {
  grid-column: 1 / -1;
  margin-top: 6px;
  min-height: 48px;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 12px 18px;
  font-weight: 700;
  background: var(--primary);
  color: #171d0e;
  transition: background 140ms ease, transform 140ms ease, box-shadow 140ms ease;
}

.primary-btn:hover:not(:disabled) {
  background: #d8f58f;
  box-shadow: 0 6px 20px rgba(200, 238, 112, 0.14);
  transform: translateY(-1px);
}

.primary-btn:active:not(:disabled) {
  transform: translateY(0);
}

.primary-btn:focus-visible,
.ghost:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 3px;
}

.primary-btn:disabled {
  cursor: wait;
  opacity: 0.7;
}

.result-panel {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.result-box {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 17px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.risk-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  border-radius: 4px;
  padding: 7px 10px;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
}

.risk-badge.fraud {
  background: var(--danger-soft);
  color: var(--danger);
}

.risk-badge.safe {
  background: var(--safe-soft);
  color: var(--safe);
}

.score-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
}

.score-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.score-row span {
  color: var(--muted);
  font-size: 0.88rem;
}

.score-row strong {
  font-family: "IBM Plex Mono", monospace;
  font-size: 0.86rem;
  font-weight: 500;
  text-align: right;
}

.alert {
  padding: 12px 14px;
  border-radius: 6px;
  border: 1px solid transparent;
  font-size: 0.96rem;
}

.alert.error {
  background: rgba(127, 29, 29, 0.24);
  border-color: rgba(248, 113, 113, 0.42);
  color: #fecaca;
}

.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10px;
  min-height: 200px;
  color: var(--muted);
  text-align: center;
}

.empty-state p {
  margin: 0;
  font-size: 1.05rem;
  color: var(--text);
}

.risk-chart-panel {
  margin-bottom: 22px;
  animation: section-enter 500ms 100ms ease-out both;
}

.risk-chart-header {
  margin-bottom: 10px;
}

.risk-chart-header h2 {
  margin: 0;
  font-size: 1.16rem;
  font-weight: 600;
}

.risk-chart-header p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 0.88rem;
}

.risk-chart-count {
  color: var(--muted);
  font-size: 0.82rem;
  font-family: "IBM Plex Mono", monospace;
  white-space: nowrap;
}

.risk-chart-plot {
  width: 100%;
  height: 250px;
}

.smaller-chart {
  height: 220px;
}

.risk-chart-empty {
  min-height: 180px;
  display: grid;
  place-items: center;
  color: var(--muted);
  text-align: center;
  border-top: 1px solid var(--border);
}

.risk-chart-empty-note {
  margin: -2px 0 0;
  color: var(--muted);
  font-size: 0.8rem;
  text-align: center;
}

.no-fraud-cases {
  color: var(--safe);
}

.risk-chart-loading {
  min-height: 180px;
  display: grid;
  place-items: center;
  color: var(--muted);
}

.risk-chart-tooltip {
  display: grid;
  gap: 5px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--bg-soft);
  color: var(--text);
  font-size: 0.82rem;
}

.risk-chart-tooltip span {
  color: var(--muted);
}

@keyframes dashboard-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes section-enter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content-grid {
    grid-template-columns: 1fr;
  }

  .result-panel {
    min-height: 220px;
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 22px 14px 36px;
  }

  .topbar,
  .panel-header,
  .overview-heading {
    flex-direction: column;
    align-items: flex-start;
  }

  .overview-meta {
    width: 100%;
    justify-content: space-between;
  }

  .topbar {
    gap: 14px;
    padding-bottom: 18px;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
  }

  h1 {
    font-size: 1.55rem;
  }

  .stats-grid {
    grid-template-columns: 1fr;
    gap: 9px;
  }

  .performance-metric {
    padding-right: 6px;
  }

  .performance-metric + .performance-metric {
    padding-left: 10px;
  }

  .stat-card {
    min-height: 108px;
  }

  .panel {
    padding: 17px;
  }

  .panel-header {
    gap: 12px;
  }

  .quick-actions {
    width: 100%;
  }

  .ghost {
    flex: 1;
  }

  .risk-chart-plot {
    height: 220px;
  }

  .risk-chart-count {
    align-self: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
